{
  "name": "clare-vogue",
  "version": "0.1.0",
  "private": true,
  "description": "Business tracking system for a fashion design and tailoring business",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace @clare-vogue/frontend",
    "dev:backend": "npm run start:dev --workspace @clare-vogue/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
